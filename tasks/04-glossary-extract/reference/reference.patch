+/**
+ * Spojí řádky zalomeného odstavce do jednoho (zalomení → mezera). Tabulátor
+ * uvnitř řádku zůstává — u zkratek odděluje zkratku od rozpisu.
+ */
+export function joinWrappedLines(text: string): string {
+  return text.replace(/[ \t]*\r?\n[ \t]*/g, ' ').trim();
+}
+
+/**
+ * Nadpis kapitoly s definicemi: „Definitions“ (bez „abbreviation“), nebo
+ * „Terms“ / „Terms and definitions“ z novější šablony 3GPP, kde nadřazená
+ * kapitola zní „Definitions of terms, symbols and abbreviations“ — dřív se
+ * tak ztratily všechny definice ~21 % specifikací (TR 22.870 „6G AI Service“).
+ */
+export function isDefinitionsHeading(heading: string): boolean {
+  const t = heading.replace(/\s+/g, ' ').trim().toLowerCase();
+  if (t.includes('definition') && !t.includes('abbreviation')) return true;
+  return /^[\d.]*\s*terms\b/.test(t);
+}
