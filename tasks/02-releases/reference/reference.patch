index 0000000..897e89e
--- /dev/null
+++ b/packages/types/src/releases.ts
@@ -0,0 +1,48 @@
+/**
+ * 3GPP releases in chronological order with the year the site associates
+ * with them (release freeze, rounded). Single source for web, API and pipeline.
+ */
+export interface ReleaseYear {
+  name: string;
+  year: number;
+}
+
+export const RELEASES: readonly ReleaseYear[] = [
+  { name: 'R99', year: 1999 },
+  { name: 'Rel-4', year: 2001 },
+  { name: 'Rel-5', year: 2002 },
+  { name: 'Rel-6', year: 2005 },
+  { name: 'Rel-7', year: 2007 },
+  { name: 'Rel-8', year: 2008 },
+  { name: 'Rel-9', year: 2009 },
+  { name: 'Rel-10', year: 2011 },
+  { name: 'Rel-11', year: 2012 },
+  { name: 'Rel-12', year: 2014 },
+  { name: 'Rel-13', year: 2016 },
+  { name: 'Rel-14', year: 2017 },
+  { name: 'Rel-15', year: 2018 },
+  { name: 'Rel-16', year: 2020 },
+  { name: 'Rel-17', year: 2022 },
+  { name: 'Rel-18', year: 2024 },
+  { name: 'Rel-19', year: 2025 },
+  { name: 'Rel-20', year: 2027 },
+  { name: 'Rel-21', year: 2029 },
+];
+
+/** Release names, oldest first. */
+export const RELEASE_NAMES: readonly string[] = RELEASES.map((r) => r.name);
+
+const VERSION_DIGITS = '0123456789abcdefghijklmnopqrstuvwxyz';
+
+/**
+ * Release from a 3-character 3GPP file version code (`38331-j40.zip` → `j40`):
+ * the first character is the major version (`3` R99, `4` Rel-4 … `a` Rel-10 …
+ * `l` Rel-21). Drafts (`0`–`2`), unknown releases and malformed codes → null.
+ */
+export function releaseFromVersionCode(code: string): string | null {
+  const value = code.toLowerCase();
+  if (!/^[0-9a-z]{3}$/.test(value)) return null;
+  const major = VERSION_DIGITS.indexOf(value[0]);
+  const name = major === 3 ? 'R99' : `Rel-${major}`;
+  return RELEASE_NAMES.includes(name) ? name : null;
+}
