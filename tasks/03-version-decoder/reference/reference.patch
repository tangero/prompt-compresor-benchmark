+import type { Metadata } from 'next'
+import VersionDecoder from '@/components/VersionDecoder'
+
+export const metadata: Metadata = {
+  title: '3GPP Version Decoder | 3GPP Explorer',
+  description: 'Decode a 3GPP file name such as 38331-j40.zip into specification number, release and version.',
+  alternates: { canonical: '/tools/version-decoder/' },
+}
+
+export default function VersionDecoderPage() {
+  return (
+    <main className="mx-auto max-w-3xl space-y-8 px-4 py-10">
+      <h1 className="text-3xl font-semibold">3GPP version decoder</h1>
+      <VersionDecoder initialInput="38331-j40.zip" />
+
+      <section>
+        <h2 className="text-xl font-semibold">How 3GPP versions work</h2>
+        <p>
+          Every 3GPP specification version has three numbers, x.y.z. The major number x identifies the release,
+          y counts technical changes and z counts editorial changes within that release.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold">Reading file names</h2>
+        <p>
+          Files on the 3GPP server are named after the specification number and a three-character version code,
+          for example 38331-j40.zip. Each character is a digit from 0 to 35 written as 0-9 and a-z, so j40 is
+          version 19.4.0 and ib0 is 18.11.0.
+        </p>
+      </section>
+      <section>
+        <h2 className="text-xl font-semibold">From version to release</h2>
+        <p>
+          Major version 3 belongs to Release 99, 4 to Release 4 and so on up to 21 for Release 21. Versions 0, 1
+          and 2 are drafts before approval and do not belong to any release yet.
+        </p>
+      </section>
+    </main>
+  )
+}
