+'use client'
+
+import { useState } from 'react'
+import Link from 'next/link'
+import { decodeSpecFile, type DecodedSpecFile } from '@/lib/versionDecoder'
+
+function decode(input: string): { result?: DecodedSpecFile; error?: string } {
+  if (!input.trim()) return {}
+  try {
+    return { result: decodeSpecFile(input) }
+  } catch (e) {
+    return { error: e instanceof Error ? e.message : 'Invalid input' }
+  }
+}
+
+export default function VersionDecoder({ initialInput = '' }: { initialInput?: string }) {
+  const [input, setInput] = useState(initialInput)
+  const { result, error } = decode(input)
+
+  return (
+    <div className="space-y-4">
+      <label className="block text-sm font-medium text-gray-700" htmlFor="version-decoder-input">
+        File name or version designation
+      </label>
+      <input
+        id="version-decoder-input"
+        type="text"
+        value={input}
+        onChange={(e) => setInput(e.target.value)}
+        placeholder="38331-j40.zip or TS 38.331 V19.4.0"
+        className="w-full rounded border border-gray-300 px-3 py-2 font-mono"
+      />
+      {error && <p className="text-sm text-red-700" role="alert">{error}</p>}
+      {result && (
+        <dl className="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
+          <dt className="text-gray-500">Specification</dt>
+          <dd>{result.specNumber}</dd>
+          <dt className="text-gray-500">Release</dt>
+          <dd>{result.release}</dd>
+          <dt className="text-gray-500">Version</dt>
+          <dd>
+            {result.versionString} (major {result.version.major}, technical {result.version.technical}, editorial{' '}
+            {result.version.editorial})
+          </dd>
+          <dt className="text-gray-500">Page</dt>
+          <dd>
+            <Link href={result.url} className="text-blue-700 underline">
+              {result.specNumber} in {result.release}
+            </Link>
+          </dd>
+        </dl>
+      )}
+    </div>
+  )
+}
