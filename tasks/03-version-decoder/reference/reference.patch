@@ -0,0 +1,51 @@
+import { formatSpecNumber } from './specUrl'
+
+export interface DecodedSpecFile {
+  specNumber: string
+  release: string
+  version: { major: number; technical: number; editorial: number }
+  versionString: string
+  url: string
+}
+
+const DIGITS = '0123456789abcdefghijklmnopqrstuvwxyz'
+// 38331-j40.zip, 36521-1-i40, ...
+const FILE_NAME = /^(\d{4,5}(?:-\d+)*)-([0-9a-z]{3})(?:\.zip)?$/
+// TS 38.331 V19.4.0, TR 38.901 V18.0.0
+const DESIGNATION = /^t[sr]\s+(\d{2}\.\d{3}(?:-\d+)*)\s+v(\d+)\.(\d+)\.(\d+)$/
+
+/** Release for a major version: 3 = R99, 4 = Rel-4 … 21 = Rel-21. */
+function releaseForMajor(major: number): string {
+  if (major < 3) throw new Error(`Version ${major}.x is a draft before approval; it has no release`)
+  if (major > 21) throw new Error(`Unknown release for major version ${major}`)
+  return major === 3 ? 'R99' : `Rel-${major}`
+}
+
+/** Decodes a 3GPP file name (`38331-j40.zip`) or designation (`TS 38.331 V19.4.0`). */
+export function decodeSpecFile(input: string): DecodedSpecFile {
+  const value = input.trim().toLowerCase()
+  let specNumber: string
+  let parts: number[]
+
+  const file = value.match(FILE_NAME)
+  const designation = file ? null : value.match(DESIGNATION)
+  if (file) {
+    specNumber = formatSpecNumber(file[1])
+    parts = file[2].split('').map((ch) => DIGITS.indexOf(ch))
+  } else if (designation) {
+    specNumber = designation[1]
+    parts = designation.slice(2, 5).map(Number)
+  } else {
+    throw new Error('Expected a file name like 38331-j40.zip or a designation like TS 38.331 V19.4.0')
+  }
+
+  const [major, technical, editorial] = parts
+  const release = releaseForMajor(major)
+  return {
+    specNumber,
+    release,
+    version: { major, technical, editorial },
+    versionString: parts.join('.'),
+    url: `/specification/${release}/${specNumber}/`,
+  }
+}
