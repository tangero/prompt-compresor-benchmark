# Jediná cesta ven z izolované sítě: Anthropic API. Přihlašovací token vkládá
# gateway, kontejner agenta ho nemá. Access log slouží k měření latence a objemu.
log_format bench escape=json '{"t":"$time_iso8601","m":"$request_method","u":"$uri","s":$status,'
  '"req_bytes":$request_length,"resp_bytes":$bytes_sent,"rt":$request_time,"urt":"$upstream_response_time"}';

server {
  listen 8787;
  access_log /var/log/nginx/bench.jsonl bench;
  client_max_body_size 64m;

  location / {
    proxy_pass https://api.anthropic.com;
    proxy_ssl_server_name on;
    proxy_set_header Host api.anthropic.com;
    proxy_set_header Authorization "Bearer ${CLAUDE_CODE_OAUTH_TOKEN}";
    proxy_set_header x-api-key "";
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
  }
}
